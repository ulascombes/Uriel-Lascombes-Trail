---
layout: null
sitemap: false
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  {%- for pg in site.html_pages %}{% unless pg.sitemap == false %}
  <url><loc>{{ pg.url | absolute_url }}</loc></url>
  {%- endunless %}{% endfor %}
  {%- for r in site.recits %}{% unless r.published == false %}
  <url><loc>{{ r.url | absolute_url }}</loc><lastmod>{{ r.date | date_to_xmlschema }}</lastmod></url>
  {%- endunless %}{% endfor %}
  {%- for t in site.tests %}
  <url><loc>{{ t.url | absolute_url }}</loc></url>
  {%- endfor %}
</urlset>
